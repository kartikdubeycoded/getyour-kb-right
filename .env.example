# Copy to .env and fill in. .env is gitignored.
NVIDIA_API_KEY=your_free_key_from_build.nvidia.com

# THE BRAIN — which LLM engine runs research, item breakdowns, and the Idea Space.
# LLM_PROVIDER=groq        # groq (default, free+fast) | deepseek | qwen | nim (fallback)
# GROQ_API_KEY=gsk_...
#
# DeepSeek (OpenAI-compatible). Cheap and strong at reasoning — good for synthesis and idea/paper
# generation. Model ids move, so both are overridable.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_DRAFT_MODEL=deepseek-v4-flash
#
# Qwen (Alibaba DashScope) — the strong synthesis brain. Get a key at bailian.console.aliyun.com
# (international) and set BOTH lines. Model ids change often: put the exact id your account shows.
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=sk-...
# QWEN_MODEL=qwen-plus            # the strong model — swap for whatever your plan gives you
# QWEN_DRAFT_MODEL=qwen-turbo     # the cheap/fast model for first-pass drafts
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # mainland: drop "-intl"

# PUSH — a Telegram digest after each 6-hourly sync (new ideas, hackathons closing, hot items).
# Both must be set or nothing is sent. Create a bot with @BotFather to get the token, then message
# your bot once and read the chat id from api.telegram.org/bot<TOKEN>/getUpdates.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=123456789

# optional overrides:
# REFRESH_HOURS=6          # gap between automatic refreshes (the heartbeat)
# DISABLE_HEARTBEAT=1      # turn the self-refresh off entirely
# INGEST_TOKEN=long_random_secret   # set BEFORE exposing via a tunnel — then the WHOLE app needs
#                                    # it: X-Ingest-Token header (iOS Shortcut) or HTTP Basic Auth
#                                    # password (browser). /health + /static stay open. Unset = open.
#                                    # generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
# NIM_MODEL=meta/llama-3.3-70b-instruct          # the strong model (reel research + the critic pass)
# NIM_DRAFT_MODEL=meta/llama-3.1-8b-instruct      # fast model for the item-analysis first pass
# NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# WHISPER_MODEL=base
# DATABASE_URL=sqlite:///reels.db
# MEDIA_DIR=media
# GITHUB_TOKEN=ghp_...   # optional — raises the GitHub radar's API rate limit
# REDDIT_CLIENT_ID=...     # for the Reddit radar — register a free "script" app at old.reddit.com/prefs/apps
# REDDIT_CLIENT_SECRET=...
